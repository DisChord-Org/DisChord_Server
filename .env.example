# Token del bot de Discord
BOT_TOKEN=
# Secreto compartido de /internal/ssh-login y /versions/update (obligatorio; sin él ambos responden 403)
INTERNAL_SECRET=
# Token de lectura de releases de los repos de la organización
GITHUB_TOKEN=
# Token de lectura de releases de los paquetes del registro
GITHUB_LIBRARIES_TOKEN=
# Fingerprint o email de la clave GPG con la que se firman los paquetes
GPG_IDENTITY=
# (Opcional) Directorio del registro; por defecto ./Repositories
DISCHORD_REPOS_DIR=
# (Opcional) Número de proxies delante del servidor; por defecto 1, false si está expuesto directamente
TRUST_PROXY=
# (Opcional) Tamaño máximo en bytes de un zip de paquete; por defecto 104857600
MAX_PACKAGE_BYTES=
